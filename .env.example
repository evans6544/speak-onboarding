# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL used in links inside emails
NEXT_PUBLIC_APP_URL=

# Resend API key for sending application emails
RESEND_API_KEY=

# CEO notification recipient
CEO_EMAIL=

# Verified sender address in Resend
FROM_EMAIL=
