# Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL used in links inside emails
NEXT_PUBLIC_APP_URL=

# Gmail account used to send application emails
GMAIL_USER=

# Google app password for the Gmail account (not the regular account password)
GMAIL_APP_PASSWORD=

# CEO notification recipient
CEO_EMAIL=

# Sender address used by Gmail SMTP
FROM_EMAIL=
